# Required: create this key in the Groq Console. Never commit the real value.
GROQ_API_KEY=gsk_your_groq_api_key

# Groq model used internally. This project does not call the OpenAI API.
GROQ_MODEL=llama-3.3-70b-versatile

# The model string to submit to MASQUERADE '26.
PUBLIC_MODEL_NAME=masquerade-groq-chatbot

# Optional. Set a secret value to require Authorization: Bearer <value>.
# Leave unset if the submission form will use API Key: none.
JUDGE_API_KEY=replace_with_a_long_random_secret

# Optional tuning.
# MAX_COMPLETION_TOKENS=700
# GROQ_TIMEOUT_SECONDS=55
